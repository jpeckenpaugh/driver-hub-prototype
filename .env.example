# --- Driver Hub server ---
PORT=3001

# --- Customer Support AI Agent (OpenCode) ---
# The server starts `opencode serve` automatically and uses a free OpenCode model.
OPENCODE_API_KEY=
OPENCODE_SUPPORT_MODEL=deepseek-v4.1-flash-free
OPENCODE_AUTOSTART=true

# Optional: use an OpenCode server that is already running instead of autostart.
# The server must expose the `support` agent (see server/src/services/opencodeSupport.ts).
# OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Optional: directory used for the support agent sandbox and logs.
# OPENCODE_SUPPORT_SANDBOX=/tmp/driver-hub-support-agent

# --- Client (optional) ---
# Point the static client at a deployed support API.
# VITE_SUPPORT_API_URL=http://localhost:3001
